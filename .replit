modules = ["nodejs-20", "python-3.11"]

[deployment]
run = ["python", "server.py"]

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["ren-find", "sish", "uwhoisd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Full Stack Discord App"

[[workflows.workflow]]
name = "Full Stack Discord App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]
