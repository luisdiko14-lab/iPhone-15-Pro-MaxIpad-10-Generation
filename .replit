modules = ["python-3.11"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[deployment]
run = "python main.py & npm start & wait"
build = "pip install . && npm install"

[[ports]]
localPort = 5000
externalPort = 80




[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Full Stack Discord App"

[[workflows.workflow]]
name = "Full Stack Discord App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
